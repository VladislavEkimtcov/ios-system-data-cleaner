# =================================================================
# ios-system-data-cleaner: Environment Configuration
# =================================================================

# MobileSync/iTunes backup root. IPHONE_BACKUP_DIR is the primary override the code reads;
# MOBILESYNC_BACKUP_DIR is accepted as an alias. Leave unset to auto-detect the OS default
# (macOS: ~/Library/Application Support/MobileSync/Backup; Windows iTunes locations).
# IPHONE_BACKUP_DIR=~/Library/Application Support/MobileSync/Backup
# MOBILESYNC_BACKUP_DIR=~/Library/Application Support/MobileSync/Backup

# Where runtime state (snapshots, market ledger, token manifests, password history) is
# stored. Defaults to ~/.ios-system-data-cleaner/ (mode 0700). Override if you must.
# IOS_CLEANER_STATE_DIR=~/.ios-system-data-cleaner

# Baseline cost of a replacement iPhone for money-saved calculations (USD).
REPLACEMENT_DEVICE_COST=799.00

# Cost per GB of Apple storage tier for the equivalent-NAND calculation ($/GB).
# (Apple charges ~$100 for +128 GB = ~$0.78 / GB.)
APPLE_STORAGE_COST_PER_GB=0.78
